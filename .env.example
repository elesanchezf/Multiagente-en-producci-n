# Copie este archivo a .env y complete los valores. No suba .env al repositorio.
# Los secretos (CF_API_TOKEN, CF_AIG_TOKEN, LANGSMITH_API_KEY) se dejan vacios aqui.

# Acceso (sesion 4). API_KEYS tiene la forma cliente:clave,cliente2:clave2.
# En produccion cada clave debe tener al menos 16 caracteres. Es un secreto:
# se escribe en Render o en .env, nunca en el repositorio.
ENVIRONMENT=development
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# Servicio
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000

# Observabilidad
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare AI Gateway (solo con MODEL_PROVIDER=gateway)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=
# Opcional. Token de autenticacion de AI Gateway (encabezado cf-aig-authorization).
# Secreto: solo del entorno. Vacio si el gateway no exige autenticacion.
CF_AIG_TOKEN=

# Modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json
